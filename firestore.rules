rules_version='2';
service cloud.firestore{match /databases/{d}/documents{
 function isAdmin(){return request.auth!=null&&exists(/databases/$(d)/documents/admins/$(request.auth.uid));}
 match /site/config{allow read:if true;allow write:if isAdmin();}
 match /site/draft{allow read,write:if isAdmin();}
 match /admins/{id}{allow read,write:if false;}
}}
